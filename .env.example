# pgstack — example environment (copy to `.env`; never commit `.env`)
# Docker Compose loads `.env` from this directory for variable substitution.

# ---- PostgreSQL (`db` service)
# Credentials for the Postgres container. The same values are interpolated into
# `DATABASE_URL` for `web` and `worker` in `docker-compose.yml`.
POSTGRES_DB=pgstack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Django (`web` + `worker`, via python-decouple in settings)
# When using Compose, `DATABASE_URL` is also set in `docker-compose.yml`; you can
# omit it here for container runs. For `manage.py` on the host, set:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pgstack
DATABASE_URL=postgresql://postgres:postgres@db:5432/pgstack

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Comma-separated hostnames; expand in production (required when DEBUG=False)
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Django settings module (`pgstack.settings.dev` for local Docker)
DJANGO_SETTINGS_MODULE=pgstack.settings.dev

# ---- Docker image build (see Dockerfile `ARG ENV`)
# `prod` → requirements/prod.txt | `dev` → requirements/dev.txt
BUILD_ENV=prod

# ---- Optional: production error reporting (requirements/prod.txt)
# SENTRY_DSN=
